{
    "compileOnSave": true,
    "compilerOptions": {
        "newLine": "LF",
        "target": "es2018",
        "module": "commonjs",
        "lib": ["es2020", "DOM"],
        "declaration": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": false,
        "strict": true,
        "esModuleInterop": true,
        "allowJs": true,
        "noEmit": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
